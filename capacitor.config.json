{
  "appId": "com.fluiditygroup.diceclubhouse.dev",
  "appName": "Dice Clubhouse Dev",
  "webDir": "dist-native",
  "android": {
    "zoomEnabled": true,
    "backgroundColor": "#0b141c"
  },
  "plugins": {
    "SystemBars": {
      "insetsHandling": "disable"
    }
  },
  "ios": {
    "zoomEnabled": true,
    "backgroundColor": "#0b141c",
    "includePlugins": [
      "@capacitor/app",
      "@capacitor/haptics",
      "@capacitor/push-notifications",
      "@capacitor/status-bar"
    ],
    "contentInset": "never"
  }
}
