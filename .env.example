# Copy to .env (gitignored) to enable the ElevenLabs voice in dev/preview.
# The key stays server-side — the Vite /api/tts proxy reads it; it is never sent to the browser.
ELEVENLABS_API_KEY=

# Public app configuration. Put real values in .env.local (gitignored).
# Never put a service_role key, secret key or database password in a VITE_ variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_GAME_WEB_URL=
# Set /yahtzee-scorekeeper/ for this repository's GitHub Pages deployment.
VITE_PUBLIC_BASE=/
# Enable after custom SMTP and the OTP email template are configured.
VITE_EMAIL_OTP_ENABLED=false
# Enable only after APNs/FCM signing, native configuration and the server delivery worker are ready.
VITE_PUSH_ENABLED=false
